          { "id": 1, "nom": "etat", "champ": "status", "cpp": "Uint16InputNode", "rafraichissement": 200, "libelle": "État des DO" },
          { "id": 5, "nom": "servo relu", "champ": "servoOnReadback", "cpp": "Uint16InputNode", "rafraichissement": 1000 } ],
        "registres ecrits": [
          { "id": 1, "nom": "servo on", "champ": "servoOn", "cpp": "Uint16OutputNode" },
          { "id": 2, "nom": "vitesse", "champ": "moveSpeed", "cpp": "Uint16OutputNode" },
          { "id": 3, "nom": "acceleration", "champ": "accelTime", "cpp": "Uint16OutputNode" },
          { "id": 4, "nom": "deceleration", "champ": "decelTime", "cpp": "Uint16OutputNode" },
          { "id": 5, "nom": "depart", "champ": "startMove", "cpp": "Uint16OutputNode" },
          { "id": 6, "nom": "depart origine", "champ": "homingStart", "cpp": "Uint16OutputNode" },
          { "id": 7, "nom": "acquittement", "champ": "alarmReset", "cpp": "Uint16OutputNode" } ]
      }
    },

    "StepperOnlineT6": {
      "nomParDefaut": "Servo",
      "libelle": "Servo StepperOnline T6 RS485 (Modbus)",
      "description": "Servo StepperOnline T6 RS485 (paramètres Prx.yy, mode PR Leadshine) piloté en Modbus RTU. Adresses en partie supposées : mise en service et vérifications dans docs/axes/stepperonline-servo.md.",
      "fichierMateriel": "StepperOnline_T6",
      "adresseParDefaut": 1,
      "pilote": "stepperonline-servo",
      "famille": "T6",
      "couple": true,
      "rampeMaxMs": 32767,                   // borne du firmware (StepperOnlineOptions)
      "ihm": { "numeriques": ["displayPosition", "alarmCode"] },
      "aideRampe": "0 = réglage du variateur conservé. T6 : ms pour 1000 tr/min (Pr9.04 / Pr9.05).",
      "noeuds": {
        "registres lus": [
          { "id": 2, "nom": "code alarme", "champ": "alarmCode", "cpp": "Uint16InputNode", "rafraichissement": 500, "libelle": "Code d’alarme" },
          { "id": 4, "nom": "etat pr", "champ": "prStatus", "cpp": "Uint16InputNode", "rafraichissement": 200, "libelle": "État PR" },
          { "id": 5, "nom": "servo relu", "champ": "servoOnReadback", "cpp": "Uint16InputNode", "rafraichissement": 1000 } ],
        "registres ecrits": [
          { "id": 1, "nom": "servo on", "champ": "servoOn", "cpp": "Uint16OutputNode" },
          { "id": 2, "nom": "vitesse", "champ": "moveSpeed", "cpp": "Uint16OutputNode" },
          { "id": 3, "nom": "acceleration", "champ": "accelTime", "cpp": "Uint16OutputNode" },
          { "id": 4, "nom": "deceleration", "champ": "decelTime", "cpp": "Uint16OutputNode" },
          { "id": 7, "nom": "mot de commande", "champ": "alarmReset", "cpp": "Uint16OutputNode" },
          { "id": 8, "nom": "commande pr", "champ": "command", "cpp": "Uint16OutputNode" },
          { "id": 9, "nom": "mode pr0", "champ": "pathMode", "cpp": "Uint16OutputNode" },
          { "id": 10, "nom": "couple max", "champ": "torqueLimit", "cpp": "Uint16OutputNode" } ]
      }
