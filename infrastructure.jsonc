    "Stepper": {
      "nomParDefaut": "Axe",
      "libelle": "Moteur pas-à-pas (STEP/DIR)",
      "description": "Driver pas-à-pas ou servo à entrée impulsions piloté par l'ESP32 (FastAccelStepper). STEP et DIR se câblent sur des GPIO directs de l'automate ; ENABLE, capteur d'origine, fins de course et alarme driver sont facultatifs.",
      "fichierMateriel": null,
      "pilote": "stepper",
      "options": [
        { "cle": "stepsPerUnit", "libelle": "Pas par unité", "type": "number", "defaut": 1, "aide": "1 = travail direct en pas (positions et course en pas)." },
        { "gabarit": "maxRange", "aide": "Butée logicielle après la prise d’origine ; 0 = pas de butée haute." },
        { "cle": "acceleration", "libelle": "Accélération (pas/s²)", "type": "number", "defaut": 5000 },
        { "cle": "homingDirection", "libelle": "Sens de la prise d’origine", "type": "select", "defaut": "-1",
          "choix": [{ "valeur": "-1", "libelle": "Vers le négatif" }, { "valeur": "1", "libelle": "Vers le positif" }],
          "aide": "Sans capteur d’origine câblé, la position courante devient l’origine." },
        { "cle": "homingSpeed", "libelle": "Vitesse de prise d’origine (pas/s)", "type": "number", "defaut": 1000 },
        { "cle": "homingBackoff", "libelle": "Dégagement après origine (pas)", "type": "number", "defaut": 200 },
        { "cle": "invertDirection", "libelle": "Inverser le sens (DIR)", "type": "bool", "defaut": false },
        { "cle": "enableActiveLow", "libelle": "ENABLE actif à l’état bas", "type": "bool", "defaut": true,
          "aide": "Coché : le driver est activé quand la sortie ENABLE est au repos (cas des drivers TB6600, DM542…)." }
      ]
    }
  },

  // ===========================================================================
  // 7. COMPILATION — environnements de platformio.ini (vérité : platformio.ini).
  //    « infra verifier » contrôle board, flash, partitions (casse comprise) et
  //    cœur Arduino. « plc check » affiche la commande de compilation de l'automate.
  // ===========================================================================
  "compilation": {
    "envParDefaut": "esp32dev",                       // = default_envs de platformio.ini
    "envsIgnores": ["test_esp32", "test_native"],     // tests du firmware : non contrôlés
    // arduino : 3 = plateforme pioarduino (URL), 2 = « espressif32 » non figé.
    "envs": {
      "quatre_mb_huge":  { "mcu": "ESP32",    "carte": "esp32dev",           "flash": "4MB",  "arduino": 3, "partitions": "partitions_4MB_no_ota.csv" },
      "esp32dev":        { "mcu": "ESP32",    "carte": "esp32dev",           "flash": "16MB", "arduino": 2, "partitions": "partitions_16MB.csv" },   // écart connu E14
      "esp32s3_n16r8":   { "mcu": "ESP32-S3", "carte": "esp32-s3-devkitc-1", "flash": "16MB", "arduino": 3, "partitions": "partitions_16Mb.csv" },
      "m5stack_stamplc": { "mcu": "ESP32-S3", "carte": "esp32-s3-devkitc-1", "flash": "8MB",  "arduino": 3, "partitions": "partitions_8MB_no_ota.csv" }
    },
    // L'Ethernet (W5500 / LAN8720) n'est compilé qu'avec le cœur Arduino 3 (EthernetManager.cpp).
    "arduinoMinPourEthernet": 3
  },

  // ===========================================================================
  // 8. FIRMWARE — ce que le firmware sait faire.
  //    "valeur" : maximum appliqué par PLC Studio (validation, découpage des sections).
  //    "verite" : où le firmware le définit ; « infra verifier » compare la valeur.
  //    Format : "fichier#SYMBOLE" ou "fichier#SYMBOLE-2" (valeur = symbole - 2) ; une
  //    liste quand le symbole est défini à plusieurs endroits (toutes doivent concorder).
  // ===========================================================================
  "firmware": {
    "version": "2.2.2",          // = BORNE_UNIVERSELLE_VERSION (borneUniverselle.h), contrôlé
    "limites": {
      "octetsNomNoeud":         { "valeur": 78,    "verite": ["src/Node/Node.h#NAME_LENGHT-2", "src/BorneUniverselle/borneUniverselle.h#NAME_LENGHT-2"], "aide": "section + « / » + nœud + zéro final < 80" },
      "octetsNomEcran":         { "valeur": 77,    "aide": "section + libellé d'un élément d'écran (interface.json)" },
      "octetsNomSection":       { "valeur": 69,    "aide": "contrôle « < 70 » de borneUniverselle.cpp (lecture de config.json)" },
      "noeudsParSection":       { "valeur": 255,   "aide": "id de nœud tronqué en uint8" },
      "noeudsAvantAlerte":      { "valeur": 300,   "aide": "au-delà, l'état complet envoyé à l'écran risque de dépasser octetsMessageEtat" },
      "octetsMessageEtat":      { "valeur": 20000, "verite": "src/BorneUniverselle/borneUniverselle.h#SOCKET_MESSAGE_MAX_SIZE" },
      "octetsMessageMSG":       { "valeur": 360,   "verite": "src/BorneUniverselle/borneUniverselle.h#MAX_MESSAGE_LENGTH" },
      "octetsTexte":            { "valeur": 512,   "verite": "src/Node/Node.h#MAX_TEXT_SIZE" },
      "octetsUrlOta":           { "valeur": 79,    "verite": "src/BorneUniverselle/borneUniverselle.h#OTA_URL_SIZE-1" },
      "caracteresNomProjet":    { "valeur": 24,    "aide": "nom de classe C++ ; « /<Nom>.json » doit faire moins de 32 octets" },
      "octetsCheminParametres": { "valeur": 31,    "aide": "« /<Nom>.json » < 32 octets (PLC_Persistence.h)" },
      "reseauxWifi":            { "valeur": 10,    "verite": "src/WifiManagement/wifimanagment.h#NB_MAX_WIFI" },
      "octetsChaineWifi":       { "valeur": 79,    "aide": "SSID, mot de passe et nom : tampons de 80 octets (wifimanagment.h)" },
      "esclavesModbusSuivis":   { "valeur": 16,    "verite": "src/MyModbus/MyModbus.h#MAX_SLAVES", "aide": "RTU et TCP confondus : au-delà, plus de détection d'esclave mort" },
      "equipementsModbusTcp":   { "valeur": 16,    "verite": "src/MyModbus/MyModbus.h#MAX_TCP_DEVICES" },
      "adressesIpModbusTcp":    { "valeur": 8,     "aide": "MODBUSIP_MAX_CLIENTS de la bibliothèque modbus-esp8266 (hors dépôt)" },
      "axesPasAPas":            { "valeur": 24,    "verite": "src/StepperMotor/StepperMotor.h#MAX_STEPPERS" }
    },

    // Type de section de config.json -> classe C++ du nœud (Node.h). Les fautes
    // « Dobble », « PF8574 », « Coilsl » sont celles du FIRMWARE : NE PAS les corriger ici.
    // "classeMateriel" : classe quand le type désigne une broche directe (pas virtuelle).
    "typesSection": {
      "PF8574_rx-bool":                   { "classe": "BooleanInputNode" },
      "PF8574_tx-bool":                   { "classe": "BooleanOutputNode" },
      "PCA9554_tx-bool":                  { "classe": "BooleanOutputNode", "nonUtilise": true },
      "EXP_rx-bool":                      { "classe": "BooleanInputNode" },
      "EXP_tx-bool":                      { "classe": "BooleanOutputNode" },
      "ModbusReadMultipleInputsStatus":   { "classe": "ModbusReadMultipleInputsRegistersNode" },
      "ModbusWriteMultipleCoils":         { "classe": "ModbusWriteMultipleCoilslNode" },
      "ModbusReadInputRegister":          { "classe": "Uint16InputNode" },
      "ModbusReadHoldingRegister":        { "classe": "Uint16InputNode" },
      "ModbusWriteHoldingRegister":       { "classe": "Uint16OutputNode" },
      "ModbusReadDobbleHoldingRegister":  { "classe": "Uint32InputNode" },
      "ModbusWriteDobbleHoldingRegister": { "classe": "Uint32OutputNode" },
      "ModbusReadCoil":                   { "classe": "BooleanInputNode", "inversionParNoeud": false },   // « inverse » par nœud ignoré par le firmware
      "ModbusWriteCoil":                  { "classe": "BooleanOutputNode" },
      "rx-bool":   { "classe": "VirtualBooleanInputNode", "classeMateriel": "BooleanInputNode" },
      "tx-bool":   { "classe": "BooleanOutputNode",       "classeMateriel": "BooleanOutputNode" },
      "rx-uint32": { "classe": "VirtualUint32InputNode" },
      "tx-uint32": { "classe": "Uint32OutputNode" },
      "rx-float":  { "classe": "VirtualFloatInputNode" },
      "tx-float":  { "classe": "FloatOutputNode" },
      "rx-text":   { "classe": "VirtualTextInputNode" },
      "tx-text":   { "classe": "VirtualTextOutputNode" }
    },

    "pucesExtension": ["PCF8574", "PCF8575", "TCA9554", "PCA9554", "TCA9534", "PCA9534", "AW9523"],
    "pucesHorloge":   { "DS3231": { "autoDetectee": true }, "PCF85063": { "autoDetectee": true }, "RX8130": { "autoDetectee": true }, "PCF8563": { "autoDetectee": false } },

    // Noms interdits pour un projet (classe C++) et pour les symboles des variables.
    // Les classes et structures de nœuds des pilotes (section 9) sont ajoutées d'office.
    "classesReservees": ["BusinessLogic", "BorneUniverselle", "Node", "State", "AxisController", "ServoDrive", "MyModbus", "EthernetManager", "RessortRoyal2"],
    // Noms de projet qui écraseraient un fichier de data/ (comparés en minuscules).
    "nomsProjetReserves": ["config", "interface", "renderers", "component-manifest", "index", "styles", "diagnostic", "main"]
  },

  // ===========================================================================
  // 9. PILOTES — un pilote = une classe C++ de src/ et son « case » dans le
  //    générateur (cpp.js) et le simulateur (sim.js). On ne peut PAS en créer un
  //    ici seul : le chargeur refuse un pilote que le code ne connaît pas.
  //    Ici : unités, bornes, écran, alias, signaux câblés et nœuds (registres).
  //    "champ" = membre de la structure de nœuds C++ (contrôlé par infra verifier).
  //    "verite" = fichiers du firmware où « infra verifier » lit structures et bornes.
  // ===========================================================================
  "pilotes": {
    "sureservo": {
      "classeCpp": "SureServo", "entete": "SureServo/SureServo.h", "structureNoeuds": "ServoNodes",
      "verite": { "entete": "src/SureServo/SureServo.h" },
      "unitePosition": "impulsions (PUU)",
      "uniteVitesse": "index 0-15 de la table de vitesses", "vitesseMin": 0, "vitesseMax": 15, "vitesseParDefaut": 5,
      "uniteVitesseJog": "tr/min", "vitesseJogMin": 1, "vitesseJogMax": 3000, "vitesseJogParDefaut": 500,
      "couple": true,
      "signaux": [
        { "cle": "servoOn", "libelle": "Servo ON", "champ": "servoOn" },
        { "cle": "immediateStop", "libelle": "Arrêt immédiat", "champ": "immediateStop" },
        { "cle": "alarmsReset", "libelle": "Reset alarmes", "champ": "alarmsReset" }
      ],
      "sections": [
        { "suffixe": "registres lus", "type": "ModbusReadHoldingRegister", "noeuds": [
          { "id": 1, "nom": "status", "champ": "status", "cpp": "Uint16InputNode", "rafraichissement": 200, "libelle": "Mot d’état servo" },
          { "id": 2, "nom": "abs coord status", "champ": "absoluteCoordonateSystemStatus", "cpp": "Uint16InputNode", "rafraichissement": 1000 },
          { "id": 3, "nom": "alarms", "champ": "alarms", "cpp": "Uint16InputNode", "rafraichissement": 1000, "libelle": "Code d’alarme servo" } ] },
        { "suffixe": "registres ecrits", "type": "ModbusWriteHoldingRegister", "noeuds": [
          { "id": 1, "nom": "aux function", "champ": "auxFunctions", "cpp": "Uint16OutputNode" },
          { "id": 2, "nom": "trigger", "champ": "trigger", "cpp": "Uint16OutputNode" },
          { "id": 4, "nom": "jog speed", "champ": "jogSpeed", "cpp": "Uint16OutputNode" },
          { "id": 5, "nom": "max torque", "champ": "maxTorque", "cpp": "Uint16OutputNode" } ] },
        { "suffixe": "position", "type": "ModbusReadDobbleHoldingRegister", "noeuds": [
          { "id": 1, "nom": "position", "champ": "position", "cpp": "Uint32InputNode", "rafraichissement": 250, "libelle": "Position actuelle" } ] },
        { "suffixe": "consignes", "type": "ModbusWriteDobbleHoldingRegister", "noeuds": [
          { "id": 1, "nom": "target A", "champ": "targetA", "cpp": "Uint32OutputNode" },
          { "id": 2, "nom": "target B", "champ": "targetB", "cpp": "Uint32OutputNode" },
          { "id": 3, "nom": "PR1 speed", "champ": "pr1Speed", "cpp": "Uint32OutputNode" },
          { "id": 4, "nom": "PR2 speed", "champ": "pr2Speed", "cpp": "Uint32OutputNode" },
          { "id": 5, "nom": "PR3 speed", "champ": "pr3Speed", "cpp": "Uint32OutputNode" },
          { "id": 6, "nom": "PR3 data", "champ": "targetC", "cpp": "Uint32OutputNode" } ] },
        { "suffixe": "etat", "type": "tx-bool", "virtuel": true, "noeuds": [
          { "id": 1, "nom": "pret", "champ": "servoReady", "cpp": "BooleanOutputNode", "libelle": "Servo prêt" },
          { "id": 2, "nom": "active", "champ": "servoActivated", "cpp": "BooleanOutputNode", "libelle": "Servo activé" },
          { "id": 3, "nom": "vitesse nulle", "champ": "zeroSpeed", "cpp": "BooleanOutputNode", "libelle": "Vitesse nulle" },
          { "id": 4, "nom": "vitesse atteinte", "champ": "targetSpeedRated", "cpp": "BooleanOutputNode", "libelle": "Vitesse atteinte" },
          { "id": 5, "nom": "en position", "champ": "targetPositionReached", "cpp": "BooleanOutputNode", "libelle": "En position" },
          { "id": 7, "nom": "alarme", "champ": "servoAlarm", "cpp": "BooleanOutputNode", "libelle": "Alarme servo" },
          { "id": 9, "nom": "position absolue perdue", "champ": "absolutePositionLost", "cpp": "BooleanOutputNode", "libelle": "Position absolue perdue" },
          { "id": 10, "nom": "alarme batterie", "champ": "batteryAlarm", "cpp": "BooleanOutputNode", "libelle": "Alarme batterie" },
          { "id": 11, "nom": "depassement tours", "champ": "multipleTurnsOverflow", "cpp": "BooleanOutputNode", "libelle": "Dépassement multi-tours" },
          { "id": 12, "nom": "depassement PUU", "champ": "puuOverflow", "cpp": "BooleanOutputNode", "libelle": "Dépassement PUU" },
          { "id": 13, "nom": "coordonnees non definies", "champ": "absoluteCoordonateNotSet", "cpp": "BooleanOutputNode", "libelle": "Coordonnées non définies" },
          { "id": 14, "nom": "origine faite", "champ": "homeDone", "cpp": "BooleanOutputNode", "libelle": "Origine faite" },
          { "id": 15, "nom": "erreur modbus", "champ": "modbusError", "cpp": "BooleanOutputNode", "libelle": "Erreur Modbus" },
          { "id": 16, "nom": "initialise", "champ": "driveInitialised", "cpp": "BooleanOutputNode", "libelle": "Variateur initialisé" } ] }
      ]
    },

    "lichuan": {
      "classeCpp": "LichuanServo", "entete": "LichuanServo/LichuanServo.h", "structureNoeuds": "LichuanNodes",
      // Où « infra verifier » lit les bornes du firmware (rampeMaxMs = maxAccelMs, vitesseMax = maxSpeedRpm).
      "verite": { "entete": "src/LichuanServo/LichuanServo.h", "source": "src/LichuanServo/LichuanServo.cpp", "options": "LichuanOptions", "enum": "LichuanFamily" },
      "familles": ["A6", "A5"],              // enum LichuanFamily
      "unitePosition": "unités de commande (impulsions)",
      "uniteVitesse": "tr/min", "vitesseMin": 1, "vitesseParDefaut": 100,
      "uniteVitesseJog": "tr/min", "vitesseJogMin": 1, "vitesseJogParDefaut": 60,
      "couple": true,
      "ihm": { "numeriques": ["position", "alarmCode", "actualSpeed"],
               "voyants": ["servoReady", "driveInitialised", "homeDone", "inPosition", "servoAlarm", "modbusError"],
               "alarmes": ["servoAlarm", "modbusError"] },
      "aliasEcran": { "pret": "servoReady", "initialise": "driveInitialised", "origineFaite": "homeDone", "enPosition": "inPosition",
                      "alarme": "servoAlarm", "erreurModbus": "modbusError", "position": "position", "codeAlarme": "alarmCode",
                      "vitesse": "actualSpeed", "etat": "status" },
      "options": [
        { "gabarit": "pulsesPerUnit", "aide": "1 = travail direct en unités de commande du variateur (PA_04A / P05-02)." },
        "maxRange",
        { "gabarit": "accelTime", "aide": "{aideRampe}" }
      ],
      "sections": [
        { "suffixe": "registres lus", "type": "ModbusReadHoldingRegister", "noeuds": [
          { "id": 1, "nom": "etat", "champ": "status", "cpp": "Uint16InputNode", "rafraichissement": 200, "libelle": "Mot d’état" },
          { "id": 2, "nom": "code alarme", "champ": "alarmCode", "cpp": "Uint16InputNode", "rafraichissement": 500, "libelle": "Code d’alarme" },
          { "id": 3, "nom": "vitesse", "champ": "actualSpeed", "cpp": "Uint16InputNode", "rafraichissement": 500, "libelle": "Vitesse (tr/min)" },
          { "id": 4, "nom": "entrees relues", "champ": "virtualInputsReadback", "cpp": "Uint16InputNode", "rafraichissement": 1000 } ] },
        { "suffixe": "registres ecrits", "type": "ModbusWriteHoldingRegister", "noeuds": "par modèle" },
        { "suffixe": "position", "type": "ModbusReadDobbleHoldingRegister", "noeuds": [
          { "id": 1, "nom": "position", "champ": "position", "cpp": "Uint32InputNode", "rafraichissement": 250, "libelle": "Position actuelle" } ] },
        { "suffixe": "consignes", "type": "ModbusWriteDobbleHoldingRegister", "noeuds": [
          { "id": 1, "nom": "cible", "champ": "targetPosition", "cpp": "Uint32OutputNode" } ] },
        { "gabarit": "etatVariateur", "libelleAlarme": "Alarme servo", "libellePret": "Servo prêt", "libelleArret": "Vitesse nulle" }
      ]
    },

    "stepperonline-rs": {
      "classeCpp": "StepperOnlineRS", "entete": "StepperOnlineRS/StepperOnlineRS.h", "structureNoeuds": "StepperOnlineRSNodes",
      "verite": { "entete": "src/StepperOnlineRS/StepperOnlineRS.h", "source": "src/StepperOnlineRS/StepperOnlineRS.cpp", "options": "StepperOnlineRSOptions", "enum": "StepperOnlineRSModel" },
      "rampeMaxMs": 10000, "rampeParDefautMs": 300,   // ms pour 0 -> 1000 tr/min (StepperOnlineRSOptions)
      "unitePosition": "pas (impulsions Pr0.00)",
      "uniteVitesse": "tr/min", "vitesseMin": 1, "vitesseMax": 3000, "vitesseParDefaut": 120,
      "uniteVitesseJog": "tr/min", "vitesseJogMin": 1, "vitesseJogMax": 3000, "vitesseJogParDefaut": 60,
      "couple": true,                       // abaisse le courant crête ; effectif si le courant de référence est réglé
      "ihm": { "numeriques": ["displayPosition", "alarmCode"],
               "voyants": ["servoReady", "driveInitialised", "homeDone", "inPosition", "servoAlarm", "modbusError"],
               "alarmes": ["servoAlarm", "modbusError"] },
      "aliasEcran": { "pret": "servoReady", "initialise": "driveInitialised", "origineFaite": "homeDone", "enPosition": "inPosition",
                      "alarme": "servoAlarm", "erreurModbus": "modbusError", "position": "displayPosition", "codeAlarme": "alarmCode",
                      "vitesse": "actualSpeed", "etat": "status" },
      // Options communes aux modèles de ce pilote. "modelesVariateur" du modèle crée l'option « Modèle ».
      "options": [
        { "gabarit": "pulsesPerUnit", "libelle": "Pas par unité", "aide": "1 = travail direct en pas (Pr0.00 impulsions par tour)." },
        "maxRange",
        { "gabarit": "accelTime", "libelle": "Rampe (ms pour 1000 tr/min)", "defaut": 300, "aide": "0 = rampe du variateur conservée." },
        "torqueRefCurrent"
      ],
      "sections": [
        { "suffixe": "registres lus", "type": "ModbusReadHoldingRegister", "noeuds": [
          { "id": 1, "nom": "etat", "champ": "status", "cpp": "Uint16InputNode", "rafraichissement": 200, "libelle": "Mot d’état" },
          { "id": 2, "nom": "code alarme", "champ": "alarmCode", "cpp": "Uint16InputNode", "rafraichissement": 500, "libelle": "Code d’alarme" },
          { "id": 3, "nom": "declenchement lu", "champ": "triggerStatus", "cpp": "Uint16InputNode", "rafraichissement": 200 },
          { "id": 4, "nom": "avertissement pr", "champ": "prWarning", "cpp": "Uint16InputNode", "rafraichissement": 500 },
          { "id": 5, "nom": "alimentation relue", "champ": "softwareEnableReadback", "cpp": "Uint16InputNode", "rafraichissement": 1000, "seulementSi": "boucleFermee" },
          { "id": 6, "nom": "vitesse", "champ": "actualSpeed", "cpp": "Uint16InputNode", "rafraichissement": 500, "libelle": "Vitesse (tr/min)" } ] },
        { "suffixe": "registres ecrits", "type": "ModbusWriteHoldingRegister", "noeuds": [
          { "id": 1, "nom": "mode pr0", "champ": "prMode", "cpp": "Uint16OutputNode" },
          { "id": 2, "nom": "vitesse", "champ": "moveSpeed", "cpp": "Uint16OutputNode" },
          { "id": 3, "nom": "acceleration", "champ": "accelTime", "cpp": "Uint16OutputNode" },
          { "id": 4, "nom": "deceleration", "champ": "decelTime", "cpp": "Uint16OutputNode" },
          { "id": 5, "nom": "declenchement", "champ": "trigger", "cpp": "Uint16OutputNode" },
          { "id": 6, "nom": "mot de commande", "champ": "controlWord", "cpp": "Uint16OutputNode" },
          { "id": 7, "nom": "alimentation", "champ": "softwareEnable", "cpp": "Uint16OutputNode", "seulementSi": "boucleFermee" },
          { "id": 9, "nom": "courant crete", "champ": "peakCurrent", "cpp": "Uint16OutputNode" } ] },
        { "suffixe": "position lue", "type": "ModbusReadDobbleHoldingRegister", "noeuds": [
          { "id": 1, "nom": "position brute", "champ": "position", "cpp": "Uint32InputNode", "rafraichissement": 250 },
          { "id": 2, "nom": "position codeur", "champ": "feedbackPosition", "cpp": "Uint32InputNode", "rafraichissement": 1000, "seulementSi": "boucleFermee" } ] },
        { "suffixe": "consignes", "type": "ModbusWriteDobbleHoldingRegister", "noeuds": [
          { "id": 1, "nom": "cible", "champ": "targetPosition", "cpp": "Uint32OutputNode" } ] },
        { "suffixe": "position", "type": "tx-uint32", "virtuel": true, "noeuds": [
          { "id": 1, "nom": "position", "champ": "displayPosition", "cpp": "Uint32OutputNode", "libelle": "Position (pas)", "affichage": "position" } ] },
        { "gabarit": "etatVariateur", "libelleAlarme": "Alarme variateur", "libellePret": "Variateur prêt", "libelleArret": "Moteur à l’arrêt" }
      ]
    },

    "stepperonline-servo": {
      "classeCpp": "StepperOnlineServo", "entete": "StepperOnlineServo/StepperOnlineServo.h", "structureNoeuds": "StepperOnlineServoNodes",
      "verite": { "entete": "src/StepperOnlineServo/StepperOnlineServo.h", "source": "src/StepperOnlineServo/StepperOnlineServo.cpp", "options": "StepperOnlineOptions", "enum": "StepperOnlineFamily" },
      "familles": ["A6RS", "T6"],            // enum StepperOnlineFamily
      "unitePosition": "unités de commande (impulsions)",
      "uniteVitesse": "tr/min", "vitesseMin": 1, "vitesseMax": 3000, "vitesseParDefaut": 100,
      "uniteVitesseJog": "tr/min", "vitesseJogMin": 1, "vitesseJogMax": 3000, "vitesseJogParDefaut": 60,
      "ihm": { "numeriques": ["displayPosition"],
               "voyants": ["servoReady", "driveInitialised", "homeDone", "inPosition", "servoAlarm", "modbusError"],
               "alarmes": ["servoAlarm", "modbusError"] },
      "aliasEcran": { "pret": "servoReady", "initialise": "driveInitialised", "origineFaite": "homeDone", "enPosition": "inPosition",
                      "alarme": "servoAlarm", "erreurModbus": "modbusError", "position": "displayPosition", "codeAlarme": "alarmCode",
                      "etat": "status" },
      "options": [
        { "gabarit": "pulsesPerUnit", "aide": "1 = travail direct en unités de commande du variateur." },
        "maxRange",
        { "gabarit": "accelTime", "aide": "{aideRampe}" }
      ],
      "sections": [
        { "suffixe": "registres lus", "type": "ModbusReadHoldingRegister", "noeuds": "par modèle" },
        { "suffixe": "registres ecrits", "type": "ModbusWriteHoldingRegister", "noeuds": "par modèle" },
        { "suffixe": "position lue", "type": "ModbusReadDobbleHoldingRegister", "noeuds": [
          { "id": 1, "nom": "position brute", "champ": "position", "cpp": "Uint32InputNode", "rafraichissement": 250 } ] },
        { "suffixe": "consignes", "type": "ModbusWriteDobbleHoldingRegister", "noeuds": [
          { "id": 1, "nom": "cible", "champ": "targetPosition", "cpp": "Uint32OutputNode" } ] },
        { "suffixe": "position", "type": "tx-uint32", "virtuel": true, "noeuds": [
          { "id": 1, "nom": "position", "champ": "displayPosition", "cpp": "Uint32OutputNode", "libelle": "Position", "affichage": "position" } ] },
        { "gabarit": "etatVariateur", "libelleAlarme": "Alarme servo", "libellePret": "Servo prêt", "libelleArret": "Vitesse nulle" }
      ]
    },

    "stepper": {
      "classeCpp": "StepperMotor", "entete": "StepperMotor/StepperMotor.h", "structureNoeuds": "StepperNodes",
      "verite": { "entete": "src/StepperMotor/StepperMotor.h" },
      "modbus": false,                      // impulsions STEP/DIR générées par l'ESP32
      "unitePosition": "pas",
      "uniteVitesse": "pas/s", "vitesseMin": 1, "vitesseMax": 200000, "vitesseParDefaut": 2000,
      "uniteVitesseJog": "pas/s", "vitesseJogMin": 1, "vitesseJogMax": 200000, "vitesseJogParDefaut": 1000,
      "couple": false,
      "ihm": { "numeriques": ["position"],
               "voyants": ["stepperReady", "stepperActivated", "driveInitialised", "homeDone", "targetPositionReached", "stepperAlarm", "limitError"],
               "alarmes": ["stepperAlarm", "limitError"] },
      "aliasEcran": { "pret": "stepperReady", "active": "stepperActivated", "initialise": "driveInitialised", "origineFaite": "homeDone",
                      "enPosition": "targetPositionReached", "alarme": "stepperAlarm", "finDeCourse": "limitError", "position": "position" },
      // "gpio": sortie GPIO directe obligatoire (impulsions) ; "sens": "entree" = entrée de l'automate.
      "signaux": [
        { "cle": "step", "libelle": "STEP (impulsions)", "champ": "stepPin", "gpio": true, "typeCpp": "HardwareBooleanOutputNode", "classeId": "CLASS_HW_BOOLEAN_OUTPUT_NODE" },
        { "cle": "dir", "libelle": "DIR (sens)", "champ": "dirPin", "gpio": true, "typeCpp": "HardwareBooleanOutputNode", "classeId": "CLASS_HW_BOOLEAN_OUTPUT_NODE" },
        { "cle": "enable", "libelle": "ENABLE", "champ": "enable", "facultatif": true },
        { "cle": "alarmsReset", "libelle": "Reset alarme driver", "champ": "alarmsReset", "facultatif": true },
        { "cle": "home", "libelle": "Capteur d'origine", "champ": "homeSwitch", "sens": "entree", "facultatif": true },
        { "cle": "limitPlus", "libelle": "Fin de course +", "champ": "limitSwitchPositive", "sens": "entree", "facultatif": true },
        { "cle": "limitMinus", "libelle": "Fin de course -", "champ": "limitSwitchNegative", "sens": "entree", "facultatif": true },
        { "cle": "driverAlarm", "libelle": "Alarme driver (ALM)", "champ": "hardwareStepperAlarm", "sens": "entree", "facultatif": true }
      ],
      "sections": [
        { "suffixe": "etat", "type": "tx-bool", "virtuel": true, "noeuds": [
          { "id": 1, "nom": "pret", "champ": "stepperReady", "cpp": "BooleanOutputNode", "libelle": "Axe prêt" },
          { "id": 2, "nom": "active", "champ": "stepperActivated", "cpp": "BooleanOutputNode", "libelle": "Driver activé" },
          { "id": 3, "nom": "initialise", "champ": "driveInitialised", "cpp": "BooleanOutputNode", "libelle": "Axe initialisé" },
          { "id": 4, "nom": "origine faite", "champ": "homeDone", "cpp": "BooleanOutputNode", "libelle": "Origine faite" },
          { "id": 5, "nom": "en position", "champ": "targetPositionReached", "cpp": "BooleanOutputNode", "libelle": "En position" },
          { "id": 6, "nom": "alarme", "champ": "stepperAlarm", "cpp": "BooleanOutputNode", "libelle": "Alarme axe" },
          { "id": 7, "nom": "fin de course", "champ": "limitError", "cpp": "BooleanOutputNode", "libelle": "Fin de course atteinte" },
          { "id": 8, "nom": "arret", "champ": "zeroSpeed", "cpp": "BooleanOutputNode", "libelle": "Moteur à l’arrêt" } ] },
        { "suffixe": "position", "type": "tx-uint32", "virtuel": true, "noeuds": [
          { "id": 1, "nom": "position", "champ": "position", "cpp": "Uint32OutputNode", "libelle": "Position (pas)" } ] }
      ]
    }
  },

  // ===========================================================================
  // 10. GABARITS — morceaux réutilisables.
  // ===========================================================================
  "gabarits": {
    // Commun à toutes les entrées de la section « automates » (appliqué d'office).
    "automate": { "nomParDefaut": "Automate", "maxParProjet": 1, "options": ["rs485Speed", "rs485Config"] },

    "voies": {
      "entrees": { "cle": "di", "libelle": "Entrées TOR", "suffixeSection": "Entrees", "sens": "entree", "donnee": "bool", "prefixe": "X", "inversable": true },
      "sorties": { "cle": "do", "libelle": "Sorties relais", "suffixeSection": "Relais", "sens": "sortie", "donnee": "bool", "prefixe": "Y" },
      // Sorties directes de l'ESP32 : seules utilisables pour les impulsions d'un pas-à-pas.
      "gpio":    { "cle": "gpio", "libelle": "Sorties directes GPIO", "suffixeSection": "GPIO", "type": "tx-bool", "sens": "sortie", "donnee": "bool", "broches": "<obligatoire>", "prefixe": "GPIO", "gpio": true },
      // Convention : buzzer = tx-bool id 9 du fichier matériel (et board.buzzer.pin).
      "buzzer":  { "cle": "buzzer", "libelle": "Buzzer (GPIO{broche})", "suffixeSection": "Buzzer", "type": "tx-bool", "sens": "sortie", "donnee": "bool", "ids": "9", "prefixe": "BUZZER", "noms": { "9": "BUZZER" }, "broche": "<obligatoire>" }
    },

    "options": {
      // --- automates ---
      "rtc": { "libelle": "Horloge {horloge} installée", "type": "bool", "defaut": true,
               "aide": "Si décoché, l'outil génère une variante du fichier matériel sans horloge (l'heure part alors de la mise sous tension)." },
      // Le firmware accepte tout entier : ajouter ici une vitesse (4800, 230400...) la propose partout.
      "rs485Speed": { "libelle": "Vitesse RS485 (bauds)", "type": "select", "defaut": "",
                      "choix": [{ "valeur": "", "libelle": "Celle du fichier matériel" }, "9600", "19200", "38400", "57600", "115200"],
                      "aide": "Tous les équipements Modbus du bus doivent être réglés à cette vitesse." },
      // Le firmware accepte SERIAL_8N1, 8N2, 8E1, 8E2, 8O1, 8O2 (borneUniverselle.cpp).
      "rs485Config": { "libelle": "Format RS485", "type": "select", "defaut": "",
                       "choix": [{ "valeur": "", "libelle": "Celui du fichier matériel" },
                                 { "valeur": "SERIAL_8N1", "libelle": "8N1 (sans parité)" },
                                 { "valeur": "SERIAL_8E1", "libelle": "8E1 (parité paire)" },
                                 { "valeur": "SERIAL_8O1", "libelle": "8O1 (parité impaire)" },
                                 { "valeur": "SERIAL_8N2", "libelle": "8N2 (2 bits de stop)" }] },

      // --- liaison Modbus : ajoutées en tête des options de tout équipement Modbus ---
      "transport": { "libelle": "Liaison Modbus", "type": "select", "defaut": "rtu",
                     "choix": [{ "valeur": "rtu", "libelle": "RS485 (Modbus RTU)" }, { "valeur": "tcp", "libelle": "Réseau (Modbus TCP)" }],
                     "aide": "TCP : équipement Modbus TCP, ou passerelle TCP → RTU (l’adresse devient le n° d’unité)." },
      "ip":   { "libelle": "Adresse IP (TCP)", "type": "text", "defaut": "", "aide": "Modbus TCP seulement, ex. 192.168.1.50." },
      "port": { "libelle": "Port (TCP)", "type": "number", "defaut": 502, "aide": "Modbus TCP seulement (502 par défaut)." },

      // --- axes ---
      "pulsesPerUnit": { "libelle": "Impulsions par unité", "type": "number", "defaut": 1, "aide": "<obligatoire>" },
      "maxRange":      { "libelle": "Course maximale (unités)", "type": "number", "defaut": 0, "aide": "Butée logicielle haute ; 0 = pas de butée haute." },
      "accelTime":     { "libelle": "Temps de rampe (ms)", "type": "number", "defaut": 0, "aide": "<obligatoire>" },
      "torqueRefCurrent": { "libelle": "Courant crête du moteur (0,1 A)", "type": "number", "defaut": 0,
                            "aide": "100 % du couple de l’axe ; 0 = couple non géré. Maximum {courantCreteMaxA} A." }
    },

    // Sections réutilisables par les pilotes (section 9).
    "sections": {
      "etatVariateur": { "suffixe": "etat", "type": "tx-bool", "virtuel": true,
        "libelleAlarme": "<obligatoire>", "libellePret": "<obligatoire>", "libelleArret": "<obligatoire>",
        "noeuds": [
          { "id": 1, "nom": "pret", "champ": "servoReady", "cpp": "BooleanOutputNode", "libelle": "{libellePret}" },
          { "id": 2, "nom": "en position", "champ": "inPosition", "cpp": "BooleanOutputNode", "libelle": "En position" },
          { "id": 3, "nom": "vitesse nulle", "champ": "zeroSpeed", "cpp": "BooleanOutputNode", "libelle": "{libelleArret}" },
          { "id": 4, "nom": "origine faite", "champ": "homeDone", "cpp": "BooleanOutputNode", "libelle": "Origine faite" },
          { "id": 5, "nom": "alarme", "champ": "servoAlarm", "cpp": "BooleanOutputNode", "libelle": "{libelleAlarme}" },
          { "id": 6, "nom": "initialise", "champ": "driveInitialised", "cpp": "BooleanOutputNode", "libelle": "Variateur initialisé" },
          { "id": 7, "nom": "erreur modbus", "champ": "modbusError", "cpp": "BooleanOutputNode", "libelle": "Erreur Modbus" } ] }
    },

    // Écran et alias d'un axe, appliqués SOUS ceux du pilote (« ihm » et « aliasEcran »
    // du pilote l'emportent). C'est l'écran du SureServo, historiquement le seul axe.
    "ecranAxe": {
      "ihm": { "numeriques": ["position", "alarms", "status"],
               "voyants": ["servoReady", "servoActivated", "driveInitialised", "homeDone", "targetPositionReached", "servoAlarm", "modbusError"],
               "alarmes": ["servoAlarm", "modbusError"] },
      "aliasEcran": { "pret": "servoReady", "active": "servoActivated", "initialise": "driveInitialised", "origineFaite": "homeDone",
                      "enPosition": "targetPositionReached", "alarme": "servoAlarm", "erreurModbus": "modbusError", "position": "position",
                      "codeAlarme": "alarms", "etat": "status" }
    }
  },

  // ===========================================================================
  // 11. ALIAS — anciens noms acceptés à l'ouverture d'un projet ou d'une spec ;
  //     le projet est réécrit avec le nouveau nom à l'enregistrement.
  //     "types"     : { "<ancienne clé d'équipement>": "<nouvelle>" }
  //     "voies"     : { "<clé d'équipement ou *>": { "<ancien nom de voie>": "<nouveau>" } }
  //     "groupes"   : { "<clé d'équipement>": { "<ancienne cle de voie>": "<nouvelle>" } }
  //     "options"   : { "<clé d'équipement>": { "<ancienne cle d'option>": "<nouvelle>" } }
  //     "sites"     : { "<ancien nom de site>": "<nouveau>" }
  //     "appareils" : { "<site>": { "<ancien nom d'appareil>": "<nouveau>" } }
  //     Les "suffixeSection", "suffixe", ids, noms et champs de nœuds ne s'aliasent
  //     pas (ils entrent dans le hash : réinstaller après un renommage).
  // ===========================================================================
  "alias": {
    "types": {},
    "voies": {
      "*": { "GPIO2_1": "GPIO2" }      // ancien nom de la sortie GPIO2 (A8S, WLED...)
    },
    "groupes": {},
    "options": {},
    "sites": {},
    "appareils": {}
  },

  // ===========================================================================
  // 12. ÉCARTS CONNUS — signalés en avertissement par « infra verifier » au lieu
  //     d'une erreur. Un écart corrigé doit être retiré (le vérificateur le dit).
  //     "controle": null = simple note, jamais contrôlée.
  // ===========================================================================
  "ecartsConnus": {
    "E02": { "controle": "axes.LichuanA5.vitesseMax", "texte": "A5 annoncé à 6000 tr/min ; LichuanServo borne à 3000 (maxSpeedRpm non relevé pour l'A5 dans LichuanOptions::defaultsFor)." },
    "E07": { "controle": "automates.Kincony_KC868_A8S.rs485.vitesse", "texte": "Fichier matériel A8S à 115000 bauds (115200 ailleurs) : faute de frappe probable." },
    "E14": { "controle": "compilation.envs.esp32dev.partitions", "texte": "platformio.ini cite partitions_16MB.csv ; le fichier s'appelle partitions_16Mb.csv (échoue sous Linux)." },
    "E15": { "controle": null, "texte": "A8S : esp32dev ici, quatre_mb_huge en déploiement réel (AUDIT MA-31). Décision à prendre." }
  }
}
