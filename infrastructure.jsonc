      "fichierMateriel": "Lichuan_A5",
      "adresseParDefaut": 1,
      "pilote": "lichuan",
      "famille": "A5",
      "vitesseMax": 6000, "vitesseJogMax": 6000,   // écart connu E02 : le firmware borne à 3000
      "rampeMaxMs": 65535,                   // borne du firmware (LichuanOptions, P11-15)
      "aideRampe": "0 = réglage du variateur conservé. A5 : ms (P11-15).",
      "noeuds": {
        "registres ecrits": [
          { "id": 1, "nom": "entrees virtuelles", "champ": "virtualInputs", "cpp": "Uint16OutputNode" },
          { "id": 2, "nom": "vitesse", "champ": "moveSpeed", "cpp": "Uint16OutputNode" },
          { "id": 3, "nom": "acceleration", "champ": "accelTime", "cpp": "Uint16OutputNode" },
          { "id": 5, "nom": "vitesse jog", "champ": "jogSpeed", "cpp": "Uint16OutputNode" },
          { "id": 6, "nom": "couple max", "champ": "torqueLimit", "cpp": "Uint16OutputNode" },
