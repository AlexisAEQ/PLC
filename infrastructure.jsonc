      "description": "Variateur pas-à-pas boucle fermée StepperOnline RS (mode PR, protocole Leadshine) piloté en Modbus RTU (usine 38400 8N1). Mise en service : docs/axes/stepperonline-rs.md.",
      "fichierMateriel": "StepperOnline_CL_RS",
      "adresseParDefaut": 1,
      "pilote": "stepperonline-rs",
      "boucleFermee": true,
      "modelesVariateur": { "CL57RS": { "courantCreteMax": 70 }, "CL86RS": { "courantCreteMax": 80 } }
    },

    "StepperOnlineA6RS": {
      "nomParDefaut": "Servo",
      "libelle": "Servo StepperOnline A6-RS (Modbus)",
      "description": "Servo StepperOnline A6 RS485 (paramètres Cgg.nn) piloté en Modbus RTU (115200 8N1 d'usine) par la logique des entrées DI. Adresses en partie supposées : mise en service et vérifications dans docs/axes/stepperonline-servo.md.",
      "fichierMateriel": "StepperOnline_A6RS",
      "adresseParDefaut": 1,
      "pilote": "stepperonline-servo",
      "famille": "A6RS",
      "couple": false,
      "rampeMaxMs": 65535,                   // borne du firmware (StepperOnlineOptions)
      "aideRampe": "0 = réglage du variateur conservé. A6-RS : ms (C11.0A / C11.0C).",
      "noeuds": {
