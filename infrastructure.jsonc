// =============================================================================
//  infrastructure.jsonc — RÉFÉRENTIEL D'INFRASTRUCTURE de PLC Studio
// =============================================================================
//
//  C'est LE fichier à modifier quand l'installation change : IP d'un robot, logiciel
//  d'un contrôleur, carte remplacée ou ajoutée, module ou variateur réadressé, bus RS485,
//  environnement de compilation, limite relevée dans le firmware, renommage...
//  PLC Studio (interface, CLI, générateur, validation, simulateur) le lit au démarrage.
//  Le firmware, lui, ne le lit JAMAIS : il lit config.json et data/hardware/*.json,
//  qui restent sa vérité (broches, registres, puces).
//
//  APRÈS CHAQUE MODIFICATION :
//      node tools/plc-studio/cli/plc.mjs infra verifier
//  (contrôle ce fichier contre data/hardware/, platformio.ini et les en-têtes C++),
//  puis « npm test » dans tools/plc-studio, et redémarrer PLC Studio s'il tourne.
//  Procédures pas à pas : docs/referentiel-infrastructure.md
//
//  SOMMAIRE (de la section la plus souvent modifiée à la plus rare)
//     1. sites         ce qui est réellement installé : IP, adresses, logiciels relevés
//     2. logiciels     logiciels de contrôleur connus (AUBO ARCS / AUBOPE, FAIRINO)
//     3. automates     cartes automates (une par fichier data/hardware)
//     4. robots        robots et équipement Modbus générique
//     5. modules       modules d'E/S déportés
//     6. axes          variateurs et moteurs (modèles)
//     7. compilation   environnements PlatformIO
//     8. firmware      ce que le firmware sait faire : version, limites, types de section
//     9. pilotes       types d'axe gérés par le CODE (contrat avec src/<Pilote>/)
//    10. gabarits      morceaux réutilisables (voies, options, sections, écran d'axe)
//    11. alias         anciens noms encore acceptés
//    12. ecartsConnus  écarts acceptés entre ce fichier et le firmware
//
//  NOTATIONS
//    "gabarit": "nom"   reprend gabarits.<famille>.<nom>, puis applique les clés locales
//                       (objets fusionnés, listes et valeurs remplacées ; null = retirer).
//    "<obligatoire>"    dans un gabarit : valeur à fournir par chaque utilisateur.
//    "{cle}"            dans un texte : remplacé par la valeur de cette clé (ex. {broche}).
//    "ids": "1-8"       plage d'identifiants ; "1-4, 9" ; un seul : "9".
//    "noms": [...]      noms des voies, dans l'ordre des ids (ou des bits d'un banc).
//    "broches": [...]   voies GPIO : ids 1..n (= ids tx-bool du fichier matériel), noms GPIO<n>.
//    "options": ["x"]   option tirée de gabarits.options.x ; { "gabarit": "x", ... } pour l'ajuster.
//    "noeuds": "par modèle"   (pilotes) chaque modèle de la section « axes » donne ces nœuds.
//    "seulementSi": "boucleFermee"   nœud présent seulement si le modèle a boucleFermee: true.
//
//  IDENTIFIANTS GELÉS — enregistrés dans les projets ou hachés dans les nœuds :
//    clés d'équipement (Kincony_KC868_A8S...), "cle" des voies, "prefixe", "noms",
//    "suffixeSection" et "suffixe" (ils entrent dans le hash des nœuds : les renommer change
//    les identifiants de interface.json et du C++), ids, "nom" et "champ" des nœuds, "cle"
//    des options et des signaux, noms de site et d'appareil.
//    Renommer = ajouter l'ancien nom dans « alias » ; « npm test » signale tout retrait.
//
//  AUCUN MOT DE PASSE NI IDENTIFIANT WIFI ICI : le chargeur refuse ces clés.
// =============================================================================
{
  "format": "plc-studio-referentiel",
  "version": 1,
  "revision": "2026-10-15 : création ; banc AUBO (i10 CB-M sous AUBOPE 4.5.13), automate POE 192.168.10.20",

  // ===========================================================================
  // 1. SITES — ce qui est réellement installé. Un projet choisit un site (étape
  //    Projet) et lie chacun de ses équipements à un appareil (étape Équipements) :
  //    IP, port, n° d'unité, adresse RS485, Ethernet et bus de l'automate viennent
  //    alors d'ici à chaque ouverture et à chaque génération. Un projet sans site
  //    n'est pas touché.
  //    Champs d'un appareil (tous facultatifs) :
  //      "type"       clé d'équipement (sections 3 à 6) : contrôle la cohérence ;
  //      "materiel"   texte libre (modèle, coffret, n° de série...) ;
  //      "logiciel"   { "nom": <section 2>, "version": "4.5.13", "releveLe": "AAAA-MM-JJ" } ;
  //      "ip"         IP de l'appareil ; "modbusTcp": { "port": 502, "unite": 1 } ou null ;
  //      "rs485"      { "adresse": 1..247 } (équipement sur le bus de l'automate) ;
  //      "ethernet"   (automate) { "ip", "masque", "passerelle", "dns" } ;
  //      "bus"        (automate) { "vitesse": 19200, "format": "SERIAL_8N1" }, null = fichier matériel ;
  //      "remarque"   texte libre.
  // ===========================================================================
  "sites": {
    "banc-aubo": {
      "libelle": "Banc AUBO i10 (atelier)",
      "reseau": { "sousReseau": "192.168.10.0/24", "passerelle": "192.168.10.1" },
      "appareils": {
        "automate": {
          "type": "Waveshare_ESP32S3_POE_8DI8DO",
          "ethernet": { "ip": "192.168.10.20", "masque": "255.255.255.0", "passerelle": "192.168.10.1" },
          "remarque": "Tablette opérateur sur le point d'accès WiFi de l'automate (192.168.4.1)."
        },
        "robot": {
          // Pas de "type" : aucun profil Modbus ne convient à un AUBO sous AUBOPE (le profil
          // Robot_Aubo exige ARCS). Le robot se câble en E/S « linkage » sur l'automate.
          "materiel": "AUBO i10, coffret CB-M",
          "logiciel": { "nom": "AUBOPE", "version": "4.5.13", "releveLe": "2026-10-11" },
          "ip": "192.168.10.50",
          "modbusTcp": null,
          "remarque": "Aucun serveur Modbus TCP vérifié sous AUBOPE ; SDK AUBO sur le port 8899 (aubo_jog.py)."
        }
        // Autres formes possibles :
        //   "io":    { "type": "Waveshare_8DIO", "rs485": { "adresse": 4 } }
        //   "cobot": { "type": "Robot_Aubo", "logiciel": { "nom": "ARCS", "version": "1.5", "releveLe": "2026-11-02" },
        //              "ip": "192.168.10.51", "modbusTcp": { "port": 502, "unite": 1 } }
      }
    }
  },

  // ===========================================================================
  // 2. LOGICIELS de contrôleur. "serveurModbusTcp": false interdit un "modbusTcp"
  //    dans un appareil qui déclare ce logiciel.
  // ===========================================================================
  "logiciels": {
    "ARCS":    { "editeur": "AUBO", "libelle": "AUBO ARCS (interface AUBO Scope)", "serveurModbusTcp": true },
    "AUBOPE":  { "editeur": "AUBO", "libelle": "AUBOPE 4.x (pendant d'origine des coffrets CB4 / CB-M)", "serveurModbusTcp": false,
                 "remarque": "Pas de serveur Modbus TCP documenté : E/S câblées « linkage » (docs/robots/aubo.md § B)." },
    "FAIRINO": { "editeur": "FAIRINO", "libelle": "Contrôleur FAIRINO (WebApp)", "serveurModbusTcp": true }
  },

  // ===========================================================================
  // 3. AUTOMATES — une entrée par fichier data/hardware/<fichierMateriel>.json.
  //    Chaque automate : nom par défaut « Automate », 1 par projet, porte le bus
  //    RS485, options RS485 ; "horloge" ajoute l'option « Horloge … installée ».
  //    La première voie doit être une entrée (toujours déclarée en entier).
  //    "marque" sert aux messages (« Ajoutez l'automate (KinCony, …) »).
  //    Contrôlé par « infra verifier » : ids, broches, buzzer, ETH, horloge, env.
  // ===========================================================================
  "automates": {
    "Kincony_KC868_A8S": {
      "marque": "KinCony",
      "libelle": "Kincony KC868-A8S",
      "description": "Automate ESP32 : 8 entrées optocouplées, 8 relais, RS485 (Modbus maître), horloge DS3231.",
      "fichierMateriel": "Kincony_KC868_A8S", // NE PAS RENOMMER : le firmware déduit le buzzer GPIO2 du nom « A8S »
      "envPlatformIO": "esp32dev",          // note E15 : déploiement réel en quatre_mb_huge ? à trancher
      "horloge": "DS3231",                  // fichier : RTC true (auto-détection)
      "voies": [
        { "gabarit": "entrees", "type": "PF8574_rx-bool", "ids": "1-8" },
        { "gabarit": "sorties", "type": "PF8574_tx-bool", "ids": "1-8" },
        // GPIO2 = buzzer de la carte (le firmware le déduit du nom de fichier « A8S »)
        { "gabarit": "gpio", "broches": [2], "libelle": "Sortie directe GPIO2 (buzzer)", "buzzerCarte": true }
      ]
    },

    "Waveshare_ESP32S3_POE_8DI8DO": {
      "marque": "Waveshare ESP32-S3",
      "libelle": "Waveshare ESP32-S3-POE-ETH-8DI-8DO",
      "description": "Automate ESP32-S3 : 8 entrées optocouplées, 8 sorties transistor (TCA9554), RS485 isolé, horloge PCF85063, buzzer, Ethernet W5500 (PoE).",
      "fichierMateriel": "Waveshare_ESP32S3_POE_8DI8DO",
      "envPlatformIO": "esp32s3_n16r8",
      "ethernet": true,
      "horloge": "PCF85063",
      "voies": [
        { "gabarit": "entrees", "type": "rx-bool", "ids": "1-8", "prefixe": "DI" },
        { "gabarit": "sorties", "type": "EXP_tx-bool", "ids": "1-8", "prefixe": "DO", "libelle": "Sorties transistor", "suffixeSection": "Sorties" },
        { "gabarit": "gpio", "broches": [40, 1, 47, 48], "libelle": "GPIO libres (à repiquer ; 47/48 : lecteur TF inutilisé)" },
        { "gabarit": "buzzer", "broche": 46 }
      ]
    },

    "Waveshare_ESP32S3_RS485_WLED": {
      "marque": "Waveshare ESP32-S3",
      "libelle": "Waveshare ESP32-S3-RS485-WLED",
      "description": "Contrôleur ESP32-S3 compact : RS485 isolé (sens automatique), 2 sorties 5 V (prévues pour bandeaux LED, idéales en STEP/DIR), 2 GPIO 3,3 V, bouton BOOT. Pas de relais ni d’entrées isolées : à compléter par des modules Modbus.",
      "fichierMateriel": "Waveshare_ESP32S3_RS485_WLED",
      "envPlatformIO": "esp32s3_n16r8",
      "voies": [
        { "cle": "di", "libelle": "Bouton BOOT (GPIO0)", "suffixeSection": "Entrees", "type": "rx-bool", "sens": "entree", "donnee": "bool", "ids": "1", "prefixe": "BOOT", "noms": ["BOOT"], "inversable": true },
        { "gabarit": "gpio", "broches": [2, 16, 3, 4], "libelle": "Sorties directes (GPIO2 et GPIO16 en 5 V, GPIO3/4 en 3,3 V)" }
      ]
    },

    "Kincony_KC868_A16": {
      "marque": "KinCony",
      "libelle": "Kincony KC868-A16",
      "description": "Automate ESP32 : 16 entrées optocouplées, 16 sorties MOSFET (PCF8574), RS485, 3 GPIO libres (HT1-HT3). Pas d’horloge.",
      "fichierMateriel": "Kincony_KC868_A16",
      "envPlatformIO": "quatre_mb_huge",
      "ethernet": true,
      "voies": [
        { "gabarit": "entrees", "type": "EXP_rx-bool", "ids": "1-16" },
        { "gabarit": "sorties", "type": "EXP_tx-bool", "ids": "1-16", "libelle": "Sorties MOSFET", "suffixeSection": "Sorties" },
        { "gabarit": "gpio", "broches": [32, 33, 14], "libelle": "GPIO libres HT1-HT3" }
      ]
    },

    "Kincony_KC868_A16v3": {
      "marque": "KinCony",
      "libelle": "Kincony KC868-A16v3",
      "description": "Automate ESP32-S3 : 16 entrées optocouplées, 16 sorties MOSFET (PCF8574), RS485, 6 GPIO libres, horloge DS3231.",
      "fichierMateriel": "Kincony_KC868_A16v3",
      "envPlatformIO": "esp32s3_n16r8",
      "ethernet": true,
      "horloge": "DS3231",                  // fichier : RTC "auto"
      "voies": [
        { "gabarit": "entrees", "type": "EXP_rx-bool", "ids": "1-16" },
        { "gabarit": "sorties", "type": "EXP_tx-bool", "ids": "1-16", "libelle": "Sorties MOSFET", "suffixeSection": "Sorties" },
        { "gabarit": "gpio", "broches": [38, 39, 40, 41, 47, 48], "libelle": "GPIO libres" }
      ]
    },

    "Kincony_KC868_A8v3": {
      "marque": "KinCony",
      "libelle": "Kincony KC868-A8v3",
      "description": "Automate ESP32-S3 : 8 entrées optocouplées, 8 relais (PCF8575), RS485, 4 GPIO libres, horloge DS3231.",
      "fichierMateriel": "Kincony_KC868_A8v3",
      "envPlatformIO": "esp32s3_n16r8",
      "ethernet": true,
      "horloge": "DS3231",
      "voies": [
        { "gabarit": "entrees", "type": "EXP_rx-bool", "ids": "1-8" },
        { "gabarit": "sorties", "type": "EXP_tx-bool", "ids": "1-8" },
        { "gabarit": "gpio", "broches": [13, 14, 40, 48], "libelle": "GPIO libres" }
      ]
    },

    "M5Stack_StamPLC": {
      "marque": "M5Stack StamPLC",
      "libelle": "M5Stack StamPLC",
      "description": "Automate ESP32-S3 : 8 entrées optocouplées, 4 relais (AW9523), RS485, horloge RX8130, buzzer, ports Grove (GPIO libres).",
      "fichierMateriel": "M5Stack_StamPLC",
      "envPlatformIO": "m5stack_stamplc",
      "horloge": "RX8130",
      "voies": [
        { "gabarit": "entrees", "type": "EXP_rx-bool", "ids": "1-8", "prefixe": "DI" },
        { "gabarit": "sorties", "type": "EXP_tx-bool", "ids": "1-4", "prefixe": "DO" },
        { "gabarit": "gpio", "broches": [4, 5, 1, 2], "libelle": "GPIO libres (ports Grove)" },
        { "gabarit": "buzzer", "broche": 44 }
      ]
    },

    "Homemaster_MiniPLC": {
      "marque": "Homemaster MiniPLC",
      "libelle": "Homemaster MiniPLC",
      "description": "Automate ESP32 : 4 entrées 24 V, 4 boutons en façade, 6 relais (PCF8574), 2 LED, RS485 isolé, horloge PCF8563, buzzer, 2 GPIO libres (bornes 1-Wire).",
      "fichierMateriel": "Homemaster_MiniPLC",
      "envPlatformIO": "quatre_mb_huge",
      "ethernet": true,
      "horloge": "PCF8563",                 // pas auto-détectée : le fichier matériel doit la nommer
      "voies": [
        { "gabarit": "entrees", "type": "rx-bool", "ids": "1-4", "prefixe": "DI" },
        { "gabarit": "entrees", "cle": "btn", "libelle": "Boutons en façade", "suffixeSection": "Boutons", "type": "EXP_rx-bool", "ids": "1-4", "prefixe": "BTN" },
        { "gabarit": "sorties", "type": "EXP_tx-bool", "ids": "1-6", "prefixe": "DO" },
        { "gabarit": "sorties", "cle": "led", "libelle": "LED en façade", "suffixeSection": "LED", "type": "EXP_tx-bool", "ids": "7-8", "prefixe": "LED", "noms": ["LED2", "LED3"] },
        { "gabarit": "gpio", "broches": [5, 4], "libelle": "GPIO libres (bornes 1-Wire)" },
        { "gabarit": "buzzer", "broche": 2 }
      ]
    }
  },

  // ===========================================================================
  // 4. ROBOTS (et équipement Modbus générique) — Modbus TCP par défaut.
  //    "logicielRequis" : logiciel que doit faire tourner le contrôleur du robot ;
  //    comparé au logiciel relevé dans le site (section 1) : un profil Robot_Aubo
  //    lié à un robot sous AUBOPE est une ERREUR (génération bloquée).
  //    "ModbusGeneric" : tout équipement Modbus sans profil ; fichier matériel
  //    généré par PLC Studio (data/hardware/Modbus_<nom>.json).
  // ===========================================================================
  "robots": {
    "ModbusGeneric": {
      "nomParDefaut": "Robot",
      "libelle": "Équipement Modbus générique (robot, automate, passerelle…)",
      "description": "Tout équipement Modbus (RTU ou TCP) : 16 bobines écrites et lues, 16 registres écrits, lus et d'entrée, à partir des adresses de départ réglées dans les options. Idéal pour piloter un robot par poignée de main (n° de programme, départ, en cours, fini).",
      "fichierMateriel": null,
      "generique": true,
      "adresseParDefaut": 1,
      "transportParDefaut": "tcp",
      "options": [
        { "cle": "oneBased", "libelle": "Adresses de la documentation comptées à partir de 1", "type": "bool", "defaut": false, "aide": "Coché : « 40001 », « 1 » = premier registre (l’outil retire 1)." },
        { "cle": "coilOutStart", "libelle": "Adresse de Q1 (bobines écrites)", "type": "number", "defaut": 0 },
        { "cle": "coilInStart", "libelle": "Adresse de I1 (bobines lues)", "type": "number", "defaut": 0 },
        { "cle": "regOutStart", "libelle": "Adresse de W1 (registres écrits)", "type": "number", "defaut": 0 },
        { "cle": "regInStart", "libelle": "Adresse de R1 (registres lus)", "type": "number", "defaut": 0 },
        { "cle": "inputRegStart", "libelle": "Adresse de IR1 (registres d’entrée)", "type": "number", "defaut": 0 }
      ],
      "voies": [
        { "cle": "q",  "libelle": "Bobines écrites (FC05)", "suffixeSection": "Bobines ecrites", "type": "ModbusWriteCoil", "sens": "sortie", "donnee": "bool", "ids": "1-16", "prefixe": "Q" },
        { "cle": "i",  "libelle": "Bobines lues (FC01)", "suffixeSection": "Bobines lues", "type": "ModbusReadCoil", "sens": "entree", "donnee": "bool", "ids": "1-16", "prefixe": "I", "inversable": true, "rafraichissement": 100 },
        { "cle": "w",  "libelle": "Registres écrits (FC06)", "suffixeSection": "Registres ecrits", "type": "ModbusWriteHoldingRegister", "sens": "sortie", "donnee": "int", "ids": "1-16", "prefixe": "W" },
        { "cle": "r",  "libelle": "Registres lus (FC03)", "suffixeSection": "Registres lus", "type": "ModbusReadHoldingRegister", "sens": "entree", "donnee": "int", "ids": "1-16", "prefixe": "R", "rafraichissement": 200 },
        { "cle": "ir", "libelle": "Registres d’entrée lus (FC04)", "suffixeSection": "Registres entree", "type": "ModbusReadInputRegister", "sens": "entree", "donnee": "int", "ids": "1-16", "prefixe": "IR", "rafraichissement": 200 }
      ]
    },

    "Robot_Aubo": {
      "nomParDefaut": "Robot",
      "libelle": "Robot AUBO sous ARCS (Modbus TCP, programme robot requis)",
      "description": "Cobot AUBO à contrôleur ARCS uniquement (interface AUBO Scope) : serveur Modbus TCP (port 502 ; unité 1 et correspondance des adresses à vérifier avant mise en mouvement), poignée de main dans les registres généraux 300 à 331 remplis par un programme robot ARCS qui suit cette convention ; départ, arrêt, pause et états critiques en TOR câblés. Ne convient pas aux contrôleurs sous AUBOPE 4.x (version lue dans « À propos » du pendant ; souvent les CB4 et CB-M d'origine) : utiliser leurs E/S câblées « linkage ». Voir docs/robots/aubo.md.",
      "fichierMateriel": "Robot_Aubo",
      "adresseParDefaut": 1,
      "transportParDefaut": "tcp",
      "logicielRequis": { "noms": ["ARCS"], "sinon": "Sous AUBOPE 4.x : pas de serveur Modbus TCP documenté ; câbler les E/S « linkage » (docs/robots/aubo.md § B)." },
      "voies": [
        { "cle": "cmd", "libelle": "Consignes vers le robot (300-308)", "suffixeSection": "Consignes", "type": "ModbusWriteHoldingRegister", "sens": "sortie", "donnee": "int", "ids": "1-9", "prefixe": "CMD",
          "noms": ["PROG", "DEPART", "ABANDON", "ACQUIT", "P1", "P2", "P3", "P4", "VIE_API"] },
        { "cle": "sts", "libelle": "Retours du robot (310-319)", "suffixeSection": "Retours", "type": "ModbusReadHoldingRegister", "sens": "entree", "donnee": "int", "ids": "1-10", "prefixe": "STS", "rafraichissement": 200,
          "noms": ["PRET", "EN_COURS", "FINI", "DEFAUT", "ECHO_PROG", "VIE_ROBOT", "V1", "V2", "V3", "V4"] },
        { "cle": "pos", "libelle": "Positions (320-331, 0,1 mm / 0,1°, signées)", "suffixeSection": "Positions", "type": "ModbusReadHoldingRegister", "sens": "entree", "donnee": "int", "ids": "11-22", "prefixe": "POS", "rafraichissement": 1000, "signe": true,
          "noms": ["TCP_X", "TCP_Y", "TCP_Z", "TCP_RX", "TCP_RY", "TCP_RZ", "J1", "J2", "J3", "J4", "J5", "J6"] }
      ]
    },

    "Robot_Fairino": {
      "nomParDefaut": "Robot",
      "libelle": "Robot FAIRINO série FR (Modbus TCP)",
      "description": "Cobot FAIRINO série FR (contrôleur V3.7.3 ou plus), serveur Modbus TCP (192.168.58.2, port 502, unité 1). Bobine 502 = départ du programme configuré ; poignée de main par les signaux utilisateur de l'esclave (adresses à confirmer) ; arrêt, pause et acquittement en TOR câblés. Mise en service : docs/robots/fairino.md.",
      "fichierMateriel": "Robot_Fairino",
      "adresseParDefaut": 1,
      "transportParDefaut": "tcp",
      "ipParDefaut": "192.168.58.2",        // IP d'usine FAIRINO
      "logicielRequis": { "noms": ["FAIRINO"], "versionMin": "3.7.3" },
      "voies": [
        { "cle": "start", "libelle": "Départ programme (bobine 502)", "suffixeSection": "Depart", "type": "ModbusWriteCoil", "sens": "sortie", "donnee": "bool", "ids": "1", "prefixe": "START", "noms": ["DEMARRER"] },
        { "cle": "do", "libelle": "Sorties du coffret robot (bobines 300-307)", "suffixeSection": "Sorties robot", "type": "ModbusWriteCoil", "sens": "sortie", "donnee": "bool", "ids": "2-9", "prefixe": "DO",
          "noms": ["DO0", "DO1", "DO2", "DO3", "DO4", "DO5", "DO6", "DO7"] },
        { "cle": "cmd", "libelle": "Commandes vers le robot (bobines utilisateur)", "suffixeSection": "Commandes", "type": "ModbusWriteMultipleCoils", "sens": "sortie", "donnee": "bool", "banc": { "noeud": 1, "bits": 8 }, "prefixe": "CMD",
          "noms": ["DEPART", "ABANDON", "ACQUIT"] },
        { "cle": "sts", "libelle": "États du robot (entrées TOR utilisateur)", "suffixeSection": "Etats", "type": "ModbusReadMultipleInputsStatus", "sens": "entree", "donnee": "bool", "banc": { "noeud": 1, "bits": 8 }, "prefixe": "STS", "inversable": true,
          "noms": ["PRET", "EN_COURS", "FINI", "DEFAUT"] },
        { "cle": "w", "libelle": "Consignes vers le robot", "suffixeSection": "Consignes", "type": "ModbusWriteHoldingRegister", "sens": "sortie", "donnee": "int", "ids": "1-5", "prefixe": "W",
          "noms": ["PROG", "P1", "P2", "P3", "VIE_API"] },
        { "cle": "ir", "libelle": "Retours du robot", "suffixeSection": "Retours", "type": "ModbusReadInputRegister", "sens": "entree", "donnee": "int", "ids": "1-5", "prefixe": "IR", "rafraichissement": 200,
          "noms": ["ECHO_PROG", "CODE_DEFAUT", "VIE_ROBOT", "V1", "V2"] },
        { "cle": "pos", "libelle": "Positions (0,1 mm / 0,1°, signées)", "suffixeSection": "Positions", "type": "ModbusReadInputRegister", "sens": "entree", "donnee": "int", "ids": "6-17", "prefixe": "POS", "rafraichissement": 1000, "signe": true,
          "noms": ["TCP_X", "TCP_Y", "TCP_Z", "TCP_RX", "TCP_RY", "TCP_RZ", "J1", "J2", "J3", "J4", "J5", "J6"] }
      ]
    }
  },

  // ===========================================================================
  // 5. MODULES d'E/S déportés (Modbus RTU par défaut).
  //    "banc" : toutes les voies dans un seul nœud ; bits = nb_values du fichier.
  // ===========================================================================
  "modules": {
    "Waveshare_8DIO": {
      "nomParDefaut": "Module ES",
      "libelle": "Waveshare Modbus RTU IO 8CH",
      "description": "Module déporté RS485 : 8 entrées TOR et 8 sorties TOR.",
      "fichierMateriel": "Waveshare_8DIO",
      "adresseParDefaut": 1,
      "voies": [
        { "cle": "di", "libelle": "Entrées TOR", "suffixeSection": "Entrees", "type": "ModbusReadMultipleInputsStatus", "sens": "entree", "donnee": "bool", "banc": { "noeud": 1, "bits": 8 }, "prefixe": "DI", "inversable": true },
        { "cle": "do", "libelle": "Sorties TOR", "suffixeSection": "Sorties", "type": "ModbusWriteMultipleCoils", "sens": "sortie", "donnee": "bool", "banc": { "noeud": 1, "bits": 8 }, "prefixe": "DO" }
      ]
    },
    "Waveshare_16DO": {
      "nomParDefaut": "Module relais",
      "libelle": "Waveshare Modbus RTU Relay 16CH",
      "description": "Module déporté RS485 : 16 sorties TOR.",
      "fichierMateriel": "Waveshare_16DO",
      "adresseParDefaut": 2,
      "voies": [
        { "cle": "do", "libelle": "Sorties TOR", "suffixeSection": "Sorties", "type": "ModbusWriteMultipleCoils", "sens": "sortie", "donnee": "bool", "banc": { "noeud": 1, "bits": 16 }, "prefixe": "DO" }
      ]
    },
    "Waveshare_8AI": {
      "nomParDefaut": "Module analogique",
      "libelle": "Waveshare Modbus RTU Analog Input 8CH",
      "description": "Module déporté RS485 : 8 entrées analogiques (registres 16 bits).",
      "fichierMateriel": "Waveshare_8AI",
      "adresseParDefaut": 3,
      "voies": [
        { "cle": "ai", "libelle": "Entrées analogiques", "suffixeSection": "Analogiques", "type": "ModbusReadInputRegister", "sens": "entree", "donnee": "int", "ids": "1-8", "prefixe": "AI", "rafraichissement": 200 }
      ]
    }
  },

  // ===========================================================================
  // 6. AXES — variateurs et moteurs. "pilote" = section 9.
  //    Les unités, l'écran et les nœuds viennent du pilote ; le modèle précise
  //    famille, bornes, fichier matériel et les nœuds « par modèle ».
  //    Bornes reprises du firmware (contrôlées par « infra verifier ») :
  //      "rampeMaxMs"        temps de rampe maximal écrit par le générateur ;
  //      "modelesVariateur"  { "<modèle>": { "courantCreteMax": <0,1 A> } } : crée l'option « Modèle ».
  //    Bus : "formatSerie": { "impose": "SERIAL_8E1" } (format fixe du variateur, contrôlé
  //    à la génération) ; "adresses": "1-32" (adresses RS485 acceptées par le variateur).
  // ===========================================================================
  "axes": {
    "SureServo": {
      "nomParDefaut": "Servo",
      "libelle": "Servo AutomationDirect SureServo 2",
      "description": "Variateur piloté en Modbus RTU (plusieurs possibles, adresses distinctes). Ses signaux TOR (servo ON, arrêt immédiat, reset alarmes) se câblent sur des sorties de l'automate.",
      "fichierMateriel": "SureServo",
      "adresseParDefaut": 127,
      "pilote": "sureservo",
      "options": [
        { "gabarit": "pulsesPerUnit", "aide": "1 = travail direct en impulsions (PUU)." },
        { "gabarit": "maxRange", "defaut": 1000000, "aide": "Butée logicielle : toute cible au-delà est refusée (avec 1 impulsion par unité, la course est en impulsions)." },
        { "cle": "homePolicy", "libelle": "Position négative", "type": "select", "defaut": "NEGATIVE_INVALIDATES_HOME",
          "choix": [{ "valeur": "NEGATIVE_INVALIDATES_HOME", "libelle": "Invalide l'origine" }, { "valeur": "NEGATIVE_TOLERATED", "libelle": "Tolérée (dérive normale)" }] }
      ]
    },

    "LichuanA6": {
      "nomParDefaut": "Servo",
      "libelle": "Servo Lichuan A6 / LCDA6 (Modbus)",
      "description": "Variateur Lichuan série A6 (paramètres PA_xxx) piloté en Modbus RTU, 8E1. Mise en service du variateur : docs/axes/lichuan.md.",
      "fichierMateriel": "Lichuan_A6",
      "adresseParDefaut": 1,
      "pilote": "lichuan",
      "famille": "A6",
      "vitesseMax": 3000, "vitesseJogMax": 3000,
      "rampeMaxMs": 2500,                    // borne du firmware (LichuanOptions, PA_058)
      "formatSerie": { "impose": "SERIAL_8E1" },   // format fixe du variateur : tout le bus en 8E1
      "adresses": "1-32",                    // PA_000
      "aideRampe": "0 = réglage du variateur conservé. A6 : ms pour 0 → 1000 tr/min (PA_058/PA_059).",
      "noeuds": {
        "registres ecrits": [
          { "id": 1, "nom": "entrees virtuelles", "champ": "virtualInputs", "cpp": "Uint16OutputNode" },
          { "id": 2, "nom": "vitesse", "champ": "moveSpeed", "cpp": "Uint16OutputNode" },
          { "id": 3, "nom": "acceleration", "champ": "accelTime", "cpp": "Uint16OutputNode" },
          { "id": 4, "nom": "deceleration", "champ": "decelTime", "cpp": "Uint16OutputNode" },
          { "id": 6, "nom": "couple max", "champ": "torqueLimit", "cpp": "Uint16OutputNode" } ]
      }
    },

    "LichuanA5": {
