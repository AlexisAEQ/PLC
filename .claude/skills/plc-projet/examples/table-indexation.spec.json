{
  "format": "plc-studio-spec",
  "name": "TableIndexation",
  "description": "Table d'indexation sur SureServo : à chaque appui sur Départ, la table avance d'un pas, attend la pièce sous le poinçon, poinçonne pendant une durée réglable et attend la remontée du poinçon. Retour à 0 en fin de course (360000 imp.), jog depuis l'écran, prise d'origine automatique.",
  "hostname": "tableindexation",
  "execution": "hmi",
  "equipment": [
    {
      "id": "plc",
      "type": "Kincony_KC868_A8S",
      "label": "Automate",
      "options": {
        "rtc": true
      }
    },
    {
      "id": "servo",
      "type": "SureServo",
      "label": "Servo",
      "address": 127,
      "options": {
        "pulsesPerUnit": 1,
        "maxRange": 360000,
        "homePolicy": "NEGATIVE_INVALIDATES_HOME"
      }
    }
  ],
  "servoSignals": {
    "servoOn": "plc.Y6",
    "immediateStop": "plc.Y7",
    "alarmsReset": "plc.Y8"
  },
  "io": [
    {
      "symbol": "AU_OK",
      "label": "Arrêt d'urgence OK",
      "at": "plc.X1",
      "comment": "Chaîne d'arrêt d'urgence NF : vrai quand tout va bien"
    },
    {
      "symbol": "BP_Depart",
      "label": "Bouton départ",
      "at": "plc.X2",
      "comment": "Contact NO : un appui = un pas d'indexation"
    },
    {
      "symbol": "BP_Arret",
      "label": "Bouton arrêt",
      "at": "plc.X3",
      "inverse": true,
      "comment": "Contact NF : vrai quand le bouton est enfoncé (ou le fil coupé)"
    },
    {
      "symbol": "Piece_presente",
      "label": "Pièce sous le poinçon",
      "at": "plc.X4"
    },
    {
      "symbol": "Poincon_haut",
      "label": "Poinçon en haut",
      "at": "plc.X5"
    },
    {
      "symbol": "Poincon",
      "label": "Poinçon",
      "at": "plc.Y1",
      "fallback": "off",
      "comment": "Électrovanne de descente du poinçon (relâchée = poinçon remonte)"
    },
    {
      "symbol": "Voyant_defaut",
      "label": "Voyant défaut",
      "at": "plc.Y2",
      "fallback": "on",
      "comment": "Allumé en arrêt d'urgence, alarme servo, pièce absente, poinçon non remonté ou origine perdue"
    }
  ],
  "variables": [
    {
      "symbol": "Acquit",
      "label": "Acquitter",
      "kind": "command",
      "dataType": "bool",
      "comment": "Acquitte l'arrêt d'urgence et les défauts"
    },
    {
      "symbol": "Mode_jog",
      "label": "Mode jog",
      "kind": "command",
      "dataType": "bool",
      "widget": "tx-bool",
      "comment": "Accessible table à l'arrêt, hors cycle"
    },
    {
      "symbol": "Jog_plus",
      "label": "Jog +",
      "kind": "command",
      "dataType": "bool",
      "widget": "tx-button-hold"
    },
    {
      "symbol": "Jog_moins",
      "label": "Jog -",
      "kind": "command",
      "dataType": "bool",
      "widget": "tx-button-hold"
    },
    {
      "symbol": "Pas",
      "label": "Pas d'indexation",
      "kind": "parameter",
      "dataType": "int",
      "initial": 9000,
      "min": 1,
      "max": 360000,
      "unit": "imp",
      "comment": "Avance de la table à chaque départ"
    },
    {
      "symbol": "Vitesse",
      "label": "Vitesse d'indexation",
      "kind": "parameter",
      "dataType": "int",
      "initial": 10,
      "min": 0,
      "max": 15,
      "comment": "Index 0 à 15 de la table des vitesses du variateur (pas et retour à 0)"
    },
    {
      "symbol": "Vitesse_jog",
      "label": "Vitesse de jog",
      "kind": "parameter",
      "dataType": "int",
      "initial": 100,
      "min": 1,
      "max": 3000,
      "comment": "Vitesse de jog envoyée au variateur (1 à 3000)"
    },
    {
      "symbol": "Tempo_poincon",
      "label": "Durée poinçonnage",
      "kind": "parameter",
      "dataType": "int",
      "initial": 500,
      "min": 50,
      "max": 10000,
      "unit": "ms"
    },
    {
      "symbol": "Tempo_piece",
      "label": "Attente pièce max.",
      "kind": "parameter",
      "dataType": "int",
      "initial": 5000,
      "min": 500,
      "max": 60000,
      "unit": "ms",
      "comment": "Au-delà : défaut pièce absente"
    },
    {
      "symbol": "Tempo_remontee",
      "label": "Remontée poinçon max.",
      "kind": "parameter",
      "dataType": "int",
      "initial": 3000,
      "min": 500,
      "max": 60000,
      "unit": "ms",
      "comment": "Au-delà : défaut poinçon non remonté"
    },
    {
      "symbol": "Cible",
      "label": "Position visée",
      "kind": "indicator",
      "dataType": "int",
      "unit": "imp"
    }
  ],
  "grafcet": {
    "steps": [
      {
        "num": 0,
        "label": "Attente départ",
        "initial": true,
        "actions": [
          "N Voyant_defaut si NON Servo.origineFaite"
        ]
      },
      {
        "num": 1,
        "label": "Calcul du pas",
        "actions": [
          "SET Cible := ((Servo.position + Pas / 2) / Pas + 1) * Pas"
        ]
      },
      {
        "num": 2,
        "label": "Avance d'un pas",
        "actions": [
          "SERVO_MOVE Cible @ Vitesse"
        ]
      },
      {
        "num": 3,
        "label": "Retour à 0",
        "actions": [
          "SET Cible := Pas",
          "SERVO_MOVE 0 @ Vitesse"
        ]
      },
      {
        "num": 4,
        "label": "Attente pièce",
        "actions": []
      },
      {
        "num": 5,
        "label": "Poinçonnage",
        "actions": [
          "N Poincon"
        ]
      },
      {
        "num": 6,
        "label": "Remontée poinçon",
        "actions": []
      },
      {
        "num": 7,
        "label": "Défaut pièce absente",
        "actions": [
          "N Voyant_defaut",
          "MSG error: Pièce absente sous le poinçon : la mettre en place puis acquitter"
        ]
      },
      {
        "num": 8,
        "label": "Défaut poinçon",
        "actions": [
          "N Voyant_defaut",
          "MSG error: Poinçon non remonté : vérifier le poinçon puis acquitter"
        ]
      }
    ],
    "transitions": [
      {
        "from": 0,
        "to": 1,
        "condition": "FM(BP_Depart) ET Poincon_haut ET Servo.origineFaite"
      },
      {
        "from": 1,
        "to": 2,
        "condition": "Cible <= 360000"
      },
      {
        "from": 1,
        "to": 3,
        "condition": "Cible > 360000"
      },
      {
        "from": 2,
        "to": 4,
        "condition": "Servo.enPosition"
      },
      {
        "from": 3,
        "to": 2,
        "condition": "Servo.enPosition"
      },
      {
        "from": 4,
        "to": 5,
        "condition": "Piece_presente"
      },
      {
        "from": 4,
        "to": 7,
        "condition": "NON Piece_presente ET X4.t >= Tempo_piece"
      },
      {
        "from": 5,
        "to": 6,
        "condition": "X5.t >= Tempo_poincon"
      },
      {
        "from": 6,
        "to": 0,
        "condition": "Poincon_haut"
      },
      {
        "from": 6,
        "to": 8,
        "condition": "NON Poincon_haut ET X6.t >= Tempo_remontee"
      },
      {
        "from": 7,
        "to": 4,
        "condition": "FM(Acquit) ET Piece_presente"
      },
      {
        "from": 8,
        "to": 0,
        "condition": "FM(Acquit) ET Poincon_haut"
      }
    ]
  },
  "modes": {
    "emergency": {
      "condition": "NON AU_OK",
      "reset": "Acquit"
    },
    "run": {
      "start": "",
      "stop": "BP_Arret"
    },
    "servo": {
      "homing": "auto",
      "homingCondition": "",
      "jogEnabled": true,
      "jogMode": "Mode_jog",
      "jogPlus": "Jog_plus",
      "jogMinus": "Jog_moins",
      "jogSpeed": "Vitesse_jog",
      "torque": ""
    }
  },
  "hmi": "auto",
  "scenarios": [
    {
      "name": "Prise d'origine automatique au démarrage",
      "steps": [
        {
          "set": {
            "AU_OK": true
          }
        },
        {
          "comment": "Aucun appui : initialisation du variateur puis prise d'origine automatique"
        },
        {
          "until": {
            "mode": "REPOS"
          },
          "timeout": "20s"
        },
        {
          "expect": {
            "Servo.origineFaite": true,
            "steps": [
              0
            ],
            "Servo.position": 0,
            "Poincon": false,
            "Voyant_defaut": false
          }
        },
        {
          "message": "Prise d'origine terminée"
        }
      ]
    },
    {
      "name": "Cycle nominal : pas de 9000, pièce, poinçon 500 ms, remontée, pas suivant",
      "steps": [
        {
          "set": {
            "AU_OK": true,
            "Poincon_haut": true
          }
        },
        {
          "until": {
            "mode": "REPOS"
          },
          "timeout": "20s"
        },
        {
          "press": "BP_Depart"
        },
        {
          "until": "X4",
          "timeout": "2s"
        },
        {
          "expect": {
            "Servo.position": 9000,
            "Cible": 9000,
            "Poincon": false,
            "mode": "CYCLE"
          }
        },
        {
          "comment": "Pas de pièce : le poinçon ne descend pas, la table attend"
        },
        {
          "wait": "1s"
        },
        {
          "expect": {
            "steps": [
              4
            ],
            "Poincon": false
          }
        },
        {
          "set": {
            "Piece_presente": true
          }
        },
        {
          "until": "X5",
          "timeout": "100ms"
        },
        {
          "expect": {
            "Poincon": true
          }
        },
        {
          "set": {
            "Poincon_haut": false
          }
        },
        {
          "comment": "Le poinçon reste commandé 500 ms"
        },
        {
          "wait": "450ms"
        },
        {
          "expect": {
            "X5": true,
            "Poincon": true
          }
        },
        {
          "wait": "70ms"
        },
        {
          "expect": {
            "steps": [
              6
            ],
            "Poincon": false
          }
        },
        {
          "comment": "Départ ignoré tant que le poinçon n'est pas remonté"
        },
        {
          "press": "BP_Depart"
        },
        {
          "wait": "300ms"
        },
        {
          "expect": {
            "steps": [
              6
            ],
            "Servo.position": 9000
          }
        },
        {
          "set": {
            "Poincon_haut": true,
            "Piece_presente": false
          }
        },
        {
          "until": {
            "steps": [
              0
            ]
          },
          "timeout": "100ms"
        },
        {
          "expect": {
            "mode": "REPOS",
            "Servo.position": 9000
          }
        },
        {
          "press": "BP_Depart"
        },
        {
          "until": "X4",
          "timeout": "2s"
        },
        {
          "expect": {
            "Servo.position": 18000,
            "Cible": 18000
          }
        }
      ]
    },
    {
      "name": "Pas et durée de poinçonnage réglables",
      "steps": [
        {
          "set": {
            "AU_OK": true,
            "Poincon_haut": true,
            "Piece_presente": true,
            "Pas": 12000,
            "Tempo_poincon": 1000
          }
        },
        {
          "until": {
            "mode": "REPOS"
          },
          "timeout": "20s"
        },
        {
          "press": "BP_Depart"
        },
        {
          "until": "X5",
          "timeout": "2s"
        },
        {
          "expect": {
            "Servo.position": 12000,
            "Poincon": true
          }
        },
        {
          "wait": "950ms"
        },
        {
          "expect": {
            "X5": true,
            "Poincon": true
          }
        },
        {
          "wait": "70ms"
        },
        {
          "expect": {
            "Poincon": false
          }
        },
        {
          "until": {
            "steps": [
              0
            ]
          },
          "timeout": "100ms"
        },
        {
          "press": "BP_Depart"
        },
        {
          "until": "X5",
          "timeout": "2s"
        },
        {
          "expect": {
