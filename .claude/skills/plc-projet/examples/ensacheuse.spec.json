        },
        {
          "until": "X1",
          "timeout": "300ms"
        },
        {
          "expect": {
            "Vis_doseuse": true
          }
        },
        {
          "set": {
            "Poids": 5000
          }
        },
        {
          "until": "X2",
          "timeout": "200ms"
        },
        {
          "expect": {
            "Soudeuse": true,
            "Vis_doseuse": false
          }
        }
      ]
    },
