          }
        },
        {
          "message": "Dosage trop long"
        },
        {
          "comment": "L'alarme reste affichée tant qu'elle n'est pas acquittée"
        },
        {
          "wait": "2s"
        },
        {
          "expect": {
            "X5": true,
            "Alarme_dosage": true,
            "Vis_doseuse": false
          }
        },
        {
          "press": "BP_Depart"
        },
        {
          "expect": {
            "X5": true,
            "Vis_doseuse": false
          }
        },
        {
          "comment": "Acquittement : retour en attente, sans redémarrage de la vis"
        },
        {
          "press": "Acquit"
        },
        {
          "until": {
            "steps": [
              0,
              10
            ]
          },
          "timeout": "200ms"
        },
        {
          "wait": "300ms"
        },
        {
          "expect": {
