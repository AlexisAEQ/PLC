      "steps": [
        {
          "set": {
            "AU_OK": true
          }
        },
        {
          "until": {
            "mode": "ARRÊT"
          },
          "timeout": "5s"
        },
        {
          "press": "Marche"
        },
        {
          "until": {
            "mode": "REPOS"
