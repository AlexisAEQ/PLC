    {
      "name": "Alarme si le dosage dure plus de 30 s : vis arrêtée, acquittement, reprise par départ",
      "steps": [
        {
          "set": {
            "AU_OK": true
          }
        },
        {
          "until": {
            "mode": "ARRÊT"
          },
          "timeout": "5s"
        },
        {
          "press": "Marche"
        },
        {
          "until": {
            "mode": "REPOS"
          },
          "timeout": "1s"
        },
        {
          "set": {
            "Sac_present": true,
            "Poids": 100
          }
        },
        {
          "press": "BP_Depart"
        },
        {
          "until": "X1",
          "timeout": "500ms"
        },
        {
          "comment": "Le poids ne monte pas (trémie vide) : pas d'alarme avant 30 s"
