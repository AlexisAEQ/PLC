  "logic": {
    "steps": [
      {
        "id": "s0",
        "num": 0,
        "label": "Programme arrêté",
        "initial": true,
        "actions": [
          {
            "type": "SET",
            "target": "Etat_programme",
            "value": "\"Arrêté\""
          }
        ],
        "x": 240,
        "y": 60
      },
      {
        "id": "s1",
        "num": 1,
        "label": "Départ programme",
        "actions": [
          {
            "type": "N",
            "target": "Cmd_start"
          },
          {
            "type": "SET",
            "target": "Etat_programme",
            "value": "\"Démarrage\""
          }
        ],
        "x": 240,
        "y": 240
      },
      {
        "id": "s2",
        "num": 2,
        "label": "Programme en cours",
        "actions": [
          {
            "type": "SET",
            "target": "Etat_programme",
            "value": "\"En cours\""
          }
        ],
        "x": 940,
        "y": 420
      },
      {
        "id": "s3",
        "num": 3,
        "label": "Arrêt programme",
        "actions": [
          {
            "type": "N",
            "target": "Cmd_stop"
          },
          {
            "type": "SET",
            "target": "Etat_programme",
            "value": "\"Arrêt demandé\""
          }
        ],
        "x": 940,
        "y": 600
      },
      {
        "id": "s4",
        "num": 4,
        "label": "Attente sélecteur",
        "actions": [
          {
            "type": "SET",
            "target": "Etat_programme",
            "value": "\"Terminé\""
          },
          {
            "type": "MSG",
            "level": "info",
            "text": "Programme robot terminé"
          }
        ],
        "x": 1780,
        "y": 780
      },
      {
        "id": "s5",
        "num": 5,
        "label": "Robot muet",
        "actions": [
          {
            "type": "N",
            "target": "Defaut_cmd"
          },
          {
            "type": "SET",
            "target": "Etat_programme",
            "value": "\"Défaut\""
          },
          {
            "type": "MSG",
            "level": "error",
            "text": "Robot ne répond pas"
          }
        ],
        "x": 1320,
        "y": 780
      }
    ],
