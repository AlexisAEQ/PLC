      "binding": {
        "eq": "eq_plc",
        "group": "di",
        "channel": 4
      },
      "hmi": {
        "show": true
      }
    },
    {
      "uid": "var_Rob_sans_defaut",
      "symbol": "Rob_sans_defaut",
      "label": "Robot sans défaut",
      "kind": "input",
      "dataType": "bool",
      "comment": "Sortie robot NotSystemError",
      "binding": {
        "eq": "eq_plc",
        "group": "di",
        "channel": 5
      },
      "hmi": {
        "show": true
      }
    },
    {
      "uid": "var_Rob_operable",
      "symbol": "Rob_operable",
      "label": "Robot opérationnel",
