        ],
        "to": [
          "s2"
        ],
        "condition": "Rob_marche",
        "x": 240,
        "y": 330
      },
      {
        "id": "t3",
        "num": 3,
        "from": [
          "s1"
        ],
        "to": [
          "s5"
        ],
        "condition": "NON Rob_marche ET X1.t >= Tempo_reponse",
        "x": 1320,
        "y": 330
      },
      {
        "id": "t4",
        "num": 4,
        "from": [
          "s2"
        ],
        "to": [
          "s3"
        ],
        "condition": "Sel_stop",
        "x": 940,
        "y": 510
      },
      {
        "id": "t5",
        "num": 5,
        "from": [
          "s2"
        ],
        "to": [
          "s4"
        ],
        "condition": "NON Rob_marche ET NON Sel_stop",
        "x": 1780,
        "y": 510
      },
      {
        "id": "t6",
        "num": 6,
        "from": [
          "s3"
        ],
        "to": [
          "s4"
        ],
        "condition": "NON Rob_marche",
        "x": 940,
        "y": 690
      },
      {
        "id": "t7",
        "num": 7,
        "from": [
          "s3"
        ],
        "to": [
          "s5"
        ],
