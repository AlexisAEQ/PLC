        "id": "t0",
        "num": 0,
        "from": [
          "s0"
        ],
        "to": [
          "s1"
        ],
        "condition": "Sel_start ET NON Sel_stop ET NON Rob_marche ET Rob_operable ET Rob_sans_defaut",
