      "label": "Sélecteur START",
      "kind": "input",
      "dataType": "bool",
      "comment": "Contact NO, sélecteur maintenu",
      "binding": {
        "eq": "eq_plc",
        "group": "di",
        "channel": 1
      },
      "hmi": {
        "show": true
      }
    },
    {
      "uid": "var_Sel_stop",
      "symbol": "Sel_stop",
      "label": "Sélecteur STOP",
      "kind": "input",
      "dataType": "bool",
      "comment": "Contact NO, sélecteur maintenu",
      "binding": {
        "eq": "eq_plc",
        "group": "di",
        "channel": 2
      },
      "hmi": {
        "show": true
      }
    },
    {
      "uid": "var_Rob_marche",
