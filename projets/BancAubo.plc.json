      "binding": {
        "eq": "eq_plc",
        "group": "di",
        "channel": 3
      },
      "hmi": {
        "show": true
      }
    },
    {
      "uid": "var_Rob_pause",
      "symbol": "Rob_pause",
      "label": "Robot en pause",
      "kind": "input",
      "dataType": "bool",
