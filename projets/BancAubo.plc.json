      "label": "Départ programme robot",
      "kind": "output",
      "dataType": "bool",
      "comment": "Entrée robot StartProgram",
      "binding": {
        "eq": "eq_plc",
        "group": "do",
        "channel": 1
      },
      "fallback": "off",
      "hmi": {
        "show": true
      }
    },
    {
      "uid": "var_Cmd_stop",
      "symbol": "Cmd_stop",
      "label": "Arrêt programme robot",
      "kind": "output",
